# Replace both secrets before starting. Do not commit .env.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
POSTGRES_PASSWORD=replace-with-a-random-database-password
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000
DJANGO_DEBUG=0
# Set to 1 when served through your own HTTPS reverse proxy.
DJANGO_HTTPS=0
TIME_ZONE=Europe/Skopje
SCRAPE_HOUR=6
SCRAPE_DELAY_SECONDS=2
SCRAPE_MAX_PAGES=100
# A descriptive user agent; optionally add your contact URL/email.
SCRAPER_USER_AGENT=MyCarTracker/0.1 (personal vehicle price tracker)
# Bind to loopback by default; put Nginx/Caddy in front for remote access.
WEB_BIND=127.0.0.1
WEB_PORT=8000
